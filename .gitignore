# ==============================================================================
# Terraform & Infrastructure as Code (IaC)
# ==============================================================================
# Local execution & cache directories
.terraform/
**/.terraform/

# Remote & local state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Execution plans & crash dumps
*.tfplan
*tfplan*
crash.log
crash.*.log

# Override files (including LocalStack auto-generated overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
localstack_providers_override.tf
localstack_providers_override.tf.json

# Local CLI configuration
.terraformrc
terraform.rc

# Variable files containing sensitive values / local overrides
*.tfvars
*.tfvars.json
*.auto.tfvars
*.auto.tfvars.json
*.auto.tfvars.local

# Whitelist example variable files
!*.example.tfvars
!*.example.tfvars.json

# ==============================================================================
# LocalStack Emulation
# ==============================================================================
.localstack/
*.localstack/

# ==============================================================================
# Secrets, Credentials & Local Environment Files
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.secret
credentials
secrets/
id_rsa*
id_ed25519*

# ==============================================================================
# Python & FastAPI Application
# ==============================================================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & quality tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Application logs
*.log
pip-log.txt
pip-delete-this-directory.txt

# ==============================================================================
# Security & CI/CD Tooling Reports
# ==============================================================================
checkov_report.*
.checkov.baseline
results.json
tflint.log

# ==============================================================================
# OS & IDE Workspace Artifacts
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (PyCharm / IntelliJ)
.idea/

# Editor swap files
*.swp
*.swo
*~
