# ==============================================================================
# Production Environment Variables Example (terraform.tfvars.example)
# Copy to terraform.tfvars to customize for local or manual deployment
# ==============================================================================

# Common Tags & Naming
prefix = "tru"
project = "demo"
environment = "prod"
region = "ap-southeast-2"
responsible_party = "devops-team"
owner = "devops"

# Network Tier (VPC 10.30.0.0/16 across 2 AZs, 2 NAT Gateways for full Multi-AZ resilience)
vpc_cidr = "10.30.0.0/16"
availability_zones = ["ap-southeast-2a", "ap-southeast-2b"]
nat_gateway_count = 2

# Compute Tier (ECS Fargate - 0.25 vCPU, 512 MiB RAM, 2 tasks for HA)
container_port = 8000
image_tag = "v1.0.0"
task_cpu = 256
task_memory = 512
desired_count = 2
enable_autoscaling = true
autoscaling_min_capacity = 2
autoscaling_max_capacity = 4
autoscaling_cpu_target = 70
log_retention_days        = 30
enable_container_insights = true

# Database Tier (RDS PostgreSQL 16.1 - Graviton2 Multi-AZ Replication)
db_name = "demo_db"
db_instance_class = "db.t4g.micro"
db_allocated_storage = 20
db_max_allocated_storage = 100
db_multi_az = true
db_backup_retention_days = 7
db_deletion_protection = true
db_skip_final_snapshot = false

# Monitoring & Budget
alarm_email = "alerts@example.com"
enable_full_alarms = true
monthly_budget_usd = 230
